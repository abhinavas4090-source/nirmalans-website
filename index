                    <div class="bg-slate-800/30 border border-slate-800 p-5 rounded-xl text-center hover:bg-slate-800/50 transition">
                        <div class="w-16 h-16 bg-slate-700 rounded-full mx-auto mb-3 flex items-center justify-center font-bold text-slate-300 border border-slate-600">

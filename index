    <!-- Contact Section -->
    <section id="contact" class="py-20 bg-slate-950 border-t border-slate-800">
        <div class="max-w-6xl mx-auto px-6">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-white mb-4">Get In Touch</h2>

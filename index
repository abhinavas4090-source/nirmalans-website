                            <p class="text-white hover:text-cyan-400 transition font-medium">+91 7356474090</p>
                        </div>
                    </a>

                    <!-- Location Card -->
                    <div class="flex items-center space-x-4 bg-slate-900 p-4 rounded-xl border border-slate-800">
                        <div class="w-12 h-12 bg-slate-800 rounded-lg flex items-center justify-center text-cyan-400 font-bold text-xl">
                            📍
                        </div>
                        <div>
                            <p class="text-xs text-slate-400 uppercase tracking-wider">Location</p>
                            <p class="text-white font-medium">India</p>
                        </div>
                    </div>
                </div>

                <!-- Contact Form -->
                <form action="https://formspree.io/f/YOUR_FORMSPREE_ID" method="POST" class="space-y-4 bg-slate-900 p-6 rounded-2xl border border-slate-800">
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Your Name</label>
                        <input type="text" name="name" required placeholder="Enter your name" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-cyan-400">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Your Email</label>
                        <input type="email" name="email" required placeholder="Enter your email" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-cyan-400">
                    </div>
                    <div>
                        <label class="block text-xs text-slate-400 mb-1">Message</label>
                        <textarea name="message" rows="4" required placeholder="Write your message here..." class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-cyan-400"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold py-2.5 rounded-lg transition">
                        Send Message
                    </button>
                </form>
            </div>
